{
  "name": "siab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "node test/balance.test.mjs && node test/api.test.mjs",
    "db:create": "wrangler d1 create siab-db",
    "db:init": "wrangler d1 execute siab-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute siab-db --local --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
