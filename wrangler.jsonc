{
  "name": "siab",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",

  // The built React app is served as static assets. Anything under /api
  // is handed to the Worker first; everything else falls back to index.html
  // so client-side routing works.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Served on the custom domain only — no workers.dev address. Cloudflare
  // creates the DNS records and issues the certificates on deploy.
  "workers_dev": false,
  "routes": [
    { "pattern": "siabofficial.com", "custom_domain": true },
    { "pattern": "www.siabofficial.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siab-db",
      "database_id": "fdf32ca2-c3a1-4ffd-945b-57e033bbe808"
    }
  ],

  "observability": { "enabled": true }
}
